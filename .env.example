MUSIC_PROVIDER_DEFAULT=deezer
TRACKWAVE_DB_PATH=./data/trackwave.db
CACHE_DB_PATH=./data/trackwave-cache.db
PORT=8787
NODE_ENV=production

# Deezer
DEEZER_CACHE_TTL_MS=21600000
DEEZER_ARTIST_ALBUMS_MAX_AGE_MS=300000
DEEZER_MAX_RELEASES=500

# Spotify (optional, only needed for provider "spotify")
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_MARKET=DE
SPOTIFY_MAX_RELEASES=500

# Nightly sync + sync worker
SCHEDULER_ENABLED=true
SCHEDULER_TIMEZONE=Europe/Berlin
SCHEDULER_DAILY_TIME=00:15
SYNC_WORKER_CONCURRENCY=2

# MusicBrainz
# Required by MusicBrainz API etiquette (app name/version/contact), otherwise your IP
# risks being rate-limited or blocked. Example: Trackwave/1.0 ( you@example.com )
MUSICBRAINZ_CONTACT=
MUSICBRAINZ_CACHE_ENABLED=true
MUSICBRAINZ_CACHE_TTL_FOUND_MS=2592000000
MUSICBRAINZ_CACHE_TTL_MISSING_MS=86400000
MUSICBRAINZ_REQUEST_SLOT_MS=1100
